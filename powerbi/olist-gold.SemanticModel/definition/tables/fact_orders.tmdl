table fact_orders
	lineageTag: 81fd8cb8-6197-4a60-b087-42ea8c024861

	measure Revenue = CALCULATE ( SUM ( fact_orders[order_value] ), NOT fact_orders[order_status] IN { "canceled", "unavailable" } )
		formatString: #,0.00
		lineageTag: ec1a634d-c2e7-4070-b479-26fac624a3bb

	measure Orders = CALCULATE ( COUNTROWS ( fact_orders ), NOT fact_orders[order_status] IN { "canceled", "unavailable" } )
		formatString: #,0
		lineageTag: 6792cd01-b554-4918-82e5-e98a7909cc2f

	measure 'Average Order Value' = DIVIDE ( [Revenue], [Orders] )
		formatString: #,0.00
		lineageTag: ec478093-b76f-45ee-9d23-c18a601b07a4

	measure 'Avg Delivery Days' = CALCULATE ( AVERAGE ( fact_orders[delivery_days] ), fact_orders[order_status] = "delivered" )
		formatString: 0.00
		lineageTag: d1d2669f-2402-4db3-8d76-bbd2f1f58a22

	measure 'Late Delivery %' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[is_late] = TRUE () ), CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[order_status] = "delivered", NOT ISBLANK ( fact_orders[delivered_customer_ts] ) ) )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a798e91a-eb1a-414d-a285-33172abdfe26

	measure 'Avg Review Score' = AVERAGE ( fact_orders[review_score] )
		formatString: 0.00
		lineageTag: 478feba9-29cc-49c4-92a7-0a8066fcc424


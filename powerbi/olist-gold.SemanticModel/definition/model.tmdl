model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_customer","dim_date","dim_product","dim_seller","fact_order_items","fact_orders"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_customer
ref table dim_date
ref table dim_product
ref table dim_seller
ref table fact_order_items
ref table fact_orders

ref cultureInfo en-US


{
	"name": "Copy_Customer_JSON_To_Folder",
	"properties": {
		"activities": [
			{
				"name": "Copy Customer Table from JSON to CSV",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ADLS_JSON_Generic_DS",
						"type": "DatasetReference",
						"parameters": {
							"folderName": "JSON",
							"fileName": "customerTable.json"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ADLS_CSV_Generic_DS",
						"type": "DatasetReference",
						"parameters": {
							"folderName": "CSV",
							"fileName": "customerTable.csv"
						}
					}
				]
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-08-30T11:24:37Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}